PROJECT_NAME="Campus Lost & Found Management System"
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_campus_lost_and_found_jwt_key_2026_dev_prod_secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default, swappable for PostgreSQL e.g., postgresql://user:password@localhost:5432/lostfound)
DATABASE_URL="sqlite:///./lost_and_found.db"

# Local Storage Directory
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

